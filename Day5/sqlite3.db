import sqlite3

# Connect to a database (or create one if it doesn't exist)
conn = sqlite3.connect("example.db")

# Create a cursor object to interact with the database
cursor = conn.cursor()

# Create a table
cursor.execute('''
CREATE TABLE IF NOT EXISTS users (
    id INT PRIMARY KEY,
    name TEXT NOT NULL,
    age INT
)
''')

# Insert data
# cursor.execute("INSERT INTO users (id, name, age) VALUES (?, ?, ?)", (101, "Alice", 30))  # ? is placeholder used for securty purpos to prevent SQL injection
# cursor.execute("INSERT INTO users (id, name,  age) VALUES (?, ?, ?)", (102, "Bob", 25))
# cursor.execute("INSERT INTO users (id, name,  age) VALUES (?, ?, ?)", (103, "Lisa", 20))

# cursor.execute("INSERT INTO users VALUES (104, 'Casey', 22), (105, 'Adam', 25), (106, 'Devid', 28)")  # another way to insert data without using ? (placeholder)

# Commit changes
conn.commit()

# Query data
cursor.execute("SELECT * FROM users")
rows = cursor.fetchall()

# Display data
for row in rows:
    print(row)

# Close the connection
conn.close()
